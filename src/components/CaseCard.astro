---
import VideoCard from './VideoCard.astro';
import FigureCard from './FigureCard.astro';
import { langFromPath, type Lang } from '../utils/i18n';
import { ui } from '../i18n/ui';

/** 案例数据（software.yml 的 cases 一项） */
interface CaseItem {
  title: string;
  caption?: string;
  meta?: string;
  video?: string;
  poster?: string;
  image?: string;
  ratio?: string;
  badge?: string;
}

interface Props {
  item: CaseItem;
  /** 角标，一般传软件名 */
  badge?: string;
  /** 自动循环播放（案例区默认开）；滚出视口会自动暂停，传 false 则给控制器点播 */
  autoplay?: boolean;
  /** 由卡片自己渲染说明；主展的说明在右侧文案栏，传 false */
  showCaption?: boolean;
  /** 语言；不传则按当前路径判断 */
  lang?: Lang;
}

const { item, badge, autoplay = false, showCaption = true } = Astro.props;
const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);
const t = ui[lang];
/** 没填 ratio 的按 16 / 9 出画面 */
const ratio = item.ratio ?? '16 / 9';
---

{
  item.image && !item.video ? (
    <FigureCard
      lang={lang}
      src={item.image}
      alt={item.title}
      ratio={ratio}
      title={showCaption ? item.title : undefined}
      caption={showCaption ? item.caption : undefined}
      meta={showCaption ? item.meta : undefined}
      placeholderLabel={item.title}
    />
  ) : (
    <VideoCard
      lang={lang}
      src={item.video}
      poster={item.poster}
      autoplay={autoplay}
      alt={item.title}
      badge={item.badge ?? badge}
      title={showCaption ? item.title : undefined}
      caption={showCaption ? item.caption : undefined}
      meta={showCaption ? item.meta : undefined}
      placeholderLabel={`${item.title}${t.common.mp4Suffix}`}
      ratio={ratio}
    />
  )
}
