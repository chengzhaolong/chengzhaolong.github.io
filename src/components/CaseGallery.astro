---
import CaseCard from './CaseCard.astro';
import { langFromPath, type Lang } from '../utils/i18n';

interface Props {
  /**
   * software.yml 的 cases，按数组顺序排版：
   * 第 1 条主展（视频 2/3 + 文案 1/3 两栏），第 2–3 条半宽，第 4 条起三分之一。
   * 全部静音自动循环播放，滚出视口自动暂停（见 VideoCard 里的 observer）。
   */
  cases: {
    title: string;
    caption?: string;
    meta?: string;
    video?: string;
    poster?: string;
    image?: string;
    ratio?: string;
    badge?: string;
  }[];
  /** 视频左上角角标，一般传软件名 */
  badge?: string;
  /** 语言；不传则按当前路径判断 */
  lang?: Lang;
}

const { cases, badge } = Astro.props;
const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);

const [hero, ...rest] = cases;
const halves = rest.slice(0, 2);
const thirds = rest.slice(2);
const total = String(cases.length).padStart(2, '0');

/** 主展、半宽、三分之一各自的栏位与延迟 */
const slots = [
  ...(hero ? [{ item: hero, span: 'span-12', hero: true, index: 0, delay: 0 }] : []),
  ...halves.map((item, i) => ({ item, span: 'span-6', hero: false, index: i + 1, delay: (i + 1) * 0.06 })),
  ...thirds.map((item, i) => ({ item, span: 'span-4', hero: false, index: i + 3, delay: (i + 3) * 0.06 })),
];
---

<div class="media-grid">
  {
    slots.map(({ item, span, hero: isHero, index, delay }) => (
      <div class={span} data-reveal style={`--d:${delay.toFixed(2)}s`}>
        {isHero ? (
          <div class="case-hero">
            <div class="case-hero__media">
              <CaseCard item={item} badge={badge} autoplay showCaption={false} lang={lang} />
            </div>
            <div class="case-hero__text">
              <span class="mono case-hero__index">
                Case {String(index + 1).padStart(2, '0')} / {total}
              </span>
              <h3>{item.title}</h3>
              {item.meta && <p class="mono case-hero__meta">{item.meta}</p>}
              {item.caption && <p class="case-hero__desc">{item.caption}</p>}
            </div>
          </div>
        ) : (
          <CaseCard item={item} badge={badge} autoplay lang={lang} />
        )}
      </div>
    ))
  }
</div>

