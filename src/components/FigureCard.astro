---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** 图片路径（public 下）或 import 进来的 ImageMetadata；都不给则显示占位云图 */
  src?: string | ImageMetadata;
  alt: string;
  caption?: string;
  /** 冒号后的补充信息，如「Fig. 3 · 温度场 / °C」 */
  meta?: string;
  placeholder?: 'a' | 'b' | 'c';
  /** 占位时显示的提示，例如「替换：切削温度场云图」 */
  placeholderLabel?: string;
  ratio?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  meta,
  placeholder = 'a',
  placeholderLabel = '仿真结果图',
  ratio,
  class: klass = '',
} = Astro.props;

const zoomSrc = typeof src === 'string' ? src : undefined;
const phClass = placeholder === 'b' ? 'media-placeholder--b' : placeholder === 'c' ? 'media-placeholder--c' : '';
---

<figure class={`figure ${klass}`} data-reveal>
  {
    src ? (
      zoomSrc ? (
        <a
          class="figure__frame"
          href={zoomSrc}
          target="_blank"
          rel="noopener"
          data-zoom={zoomSrc}
          data-zoom-alt={alt}
          data-zoom-caption={caption ?? ''}
          data-zoom-meta={meta ?? ''}
          style={ratio ? `aspect-ratio:${ratio}` : undefined}
        >
          <img src={zoomSrc} alt={alt} loading="lazy" decoding="async" />
          <span class="figure__zoom">放大 ⤢</span>
        </a>
      ) : (
        <div class="figure__frame" style={ratio ? `aspect-ratio:${ratio}` : undefined}>
          <Image
            src={src as ImageMetadata}
            alt={alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 900px) 100vw, 50vw"
            loading="lazy"
          />
          <span class="figure__zoom">放大 ⤢</span>
        </div>
      )
    ) : (
      <div
        class={`figure__frame media-placeholder ${phClass}`}
        role="img"
        aria-label={alt}
        style={ratio ? `aspect-ratio:${ratio}` : undefined}
      >
        <span class="media-placeholder__grid" aria-hidden="true"></span>
        <span class="media-placeholder__label">
          <b>待替换</b>
          {placeholderLabel}
        </span>
      </div>
    )
  }
  {(caption || meta) && (
    <figcaption class="figure__cap">
      {meta && <span class="mono">{meta}</span>}
      {caption && <span>{caption}</span>}
    </figcaption>
  )}
</figure>
