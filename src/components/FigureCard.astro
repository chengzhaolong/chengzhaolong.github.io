---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { langFromPath, type Lang } from '../utils/i18n';
import { ui } from '../i18n/ui';

interface Props {
  /** 图片路径（public 下）或 import 进来的 ImageMetadata；都不给则显示占位云图 */
  src?: string | ImageMetadata;
  alt: string;
  caption?: string;
  /** 冒号后的补充信息，如「Fig. 3 · 温度场 / °C」 */
  meta?: string;
  /** 图注里的中文标题（放在 meta 之前，可省略） */
  title?: string;
  placeholder?: 'a' | 'b' | 'c';
  /** 占位时显示的提示，例如「替换：切削温度场云图」 */
  placeholderLabel?: string;
  ratio?: string;
  class?: string;
  /** 语言；不传则按当前路径判断 */
  lang?: Lang;
}

const {
  src,
  alt,
  caption,
  meta,
  title,
  placeholder = 'a',
  placeholderLabel,
  ratio,
  class: klass = '',
} = Astro.props;

const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);
const t = ui[lang];
/** 占位卡片上的提示行（默认值随语言变，所以不能写在解构默认值里） */
const label = placeholderLabel ?? t.a11y.placeholderFigure;

const zoomSrc = typeof src === 'string' ? src : undefined;
const phClass = placeholder === 'b' ? 'media-placeholder--b' : placeholder === 'c' ? 'media-placeholder--c' : '';
---

<figure class={`figure ${klass}`} data-reveal>
  {
    src ? (
      zoomSrc ? (
        <a
          class="figure__frame"
          href={zoomSrc}
          target="_blank"
          rel="noopener"
          data-zoom={zoomSrc}
          data-zoom-alt={alt}
          data-zoom-caption={caption ?? ''}
          data-zoom-meta={meta ?? ''}
          style={ratio ? `aspect-ratio:${ratio}` : undefined}
        >
          <img src={zoomSrc} alt={alt} loading="lazy" decoding="async" />
          <span class="figure__zoom">{t.a11y.zoom}</span>
        </a>
      ) : (
        <div class="figure__frame" style={ratio ? `aspect-ratio:${ratio}` : undefined}>
          <Image
            src={src as ImageMetadata}
            alt={alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 900px) 100vw, 50vw"
            loading="lazy"
          />
          <span class="figure__zoom">{t.a11y.zoom}</span>
        </div>
      )
    ) : (
      <div
        class={`figure__frame media-placeholder ${phClass}`}
        role="img"
        aria-label={alt}
        style={ratio ? `aspect-ratio:${ratio}` : undefined}
      >
        <span class="media-placeholder__grid" aria-hidden="true"></span>
        <span class="media-placeholder__label">
          <b>{t.a11y.placeholder}</b>
          {label}
        </span>
      </div>
    )
  }
  {(caption || meta || title) && (
    <figcaption class="figure__cap">
      {title && <span class="figure__title">{title}</span>}
      {meta && <span class="mono">{meta}</span>}
      {caption && <span>{caption}</span>}
    </figcaption>
  )}
</figure>
