---
import { getEntry } from 'astro:content';
import { counterpartPath, langFromPath, withLang, type Lang } from '../utils/i18n';
import { ui } from '../i18n/ui';
import { profileText } from '../utils/localize';

interface Props {
  /** 语言；不传则按当前路径判断（/en/* 视为英文） */
  lang?: Lang;
}

const entry = await getEntry('profile', 'main');
const profile = entry?.data;
if (!profile) throw new Error('Footer 需要 profile 数据');

const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);
const t = ui[lang];
const pt = profileText(profile, lang);

const year = new Date().getFullYear();
/** 另一个语言：页脚的语言入口显示它的全称（导航里是简写） */
const other: Lang = lang === 'en' ? 'zh' : 'en';
const otherLabel = other === 'en' ? 'English' : '中文';

const navLinks = [
  { href: '/', label: t.nav.home },
  { href: '/software', label: t.nav.software },
  { href: '/publications', label: t.nav.publications },
  ...(profile.show_notes ? [{ href: '/notes', label: t.nav.notes }] : []),
  { href: '/about', label: t.nav.cv },
].map((l) => ({ ...l, href: withLang(l.href, lang) }));

const contacts = [
  { label: t.footer.email, href: `mailto:${profile.email}` },
  { label: t.footer.scholar, href: profile.links?.scholar },
  { label: t.footer.orcid, href: profile.links?.orcid },
  { label: t.footer.github, href: profile.links?.github },
  { label: t.footer.bilibili, href: profile.links?.bilibili },
].filter((c) => c.href);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div>
        <p class="site-footer__name">{pt.name}</p>
        <p class="site-footer__lede mono" style="font-size:0.8rem;color:#6f6f7a">
          {pt.affiliation}
        </p>
      </div>

      <div class="site-footer__cols">
        <div class="site-footer__col">
          <h3>{t.footer.navHeading}</h3>
          <ul>
            {navLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            <li>
              <a href={counterpartPath(Astro.url.pathname, other)} hreflang={other === 'en' ? 'en' : 'zh-CN'}>
                {otherLabel}
              </a>
            </li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h3>{t.footer.contactHeading}</h3>
          <ul>
            {
              contacts.map((c) => (
                <li>
                  <a href={c.href}>{c.label}</a>
                </li>
              ))
            }
            {profile.links?.cv && (
              <li><a href={profile.links.cv} download>{t.footer.cv}</a></li>
            )}
          </ul>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>{t.footer.copyright(year)}</span>
      <span class="accent-rule" aria-hidden="true"></span>
      <span>{t.footer.builtWith}</span>
    </div>
  </div>
</footer>
