---
import type { CollectionEntry } from 'astro:content';
import { langFromPath, type Lang } from '../utils/i18n';
import { ui } from '../i18n/ui';

interface Props {
  /** manual 数据；英文页传 localizeManual 之后的版本（章节已翻成英文） */
  manual: CollectionEntry<'manual'>['data'];
  /** 精简模式：目录只留「章 · 标题 · 页」，标题与摘要照留（软件页用） */
  compact?: boolean;
  /** 语言；不传则按当前路径判断 */
  lang?: Lang;
}

const { manual, compact = false } = Astro.props;
const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);
const t = ui[lang];
/**
 * 手册正文是中文，英文页只翻译了章节标题 —— 必须写在页面上，
 * 否则访客打开 PDF 会以为拿错了文件。
 */
const LANG_NOTE =
  'The manual itself is written in Chinese; the chapter titles and summaries on this page are translated.';
/** 章节深链：PDF 的 #page=N 是物理页，和页脚「第 N 页」一致 */
const at = (page: number) => `${manual.file}#page=${page}`;
---

<section class="section--tight section--line" id="docs">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        <span class="eyebrow">{t.manual.eyebrow}</span>
        <h2 style="margin-top:.6rem">{t.manual.heading}</h2>
        <p>{t.manual.lede}</p>
      </div>
      <span class="badge badge--dot">{manual.version}</span>
    </div>

    <div class="split split--top">
      <div data-reveal>
        <p class="card__meta mono">
          {manual.version} · {t.manual.meta(manual.pages)} · {manual.size} · {manual.date}
        </p>
        <h3 style="margin-top:.6rem;font-size:var(--fs-h2)">{manual.title}</h3>
        {manual.subtitle && <p class="muted" style="margin-top:.5rem">{manual.subtitle}</p>}
        {manual.abstract && <p style="margin-top:1rem;color:var(--ink-2)">{manual.abstract}</p>}

        <div class="cluster" style="margin-top:1.5rem">
          <a class="btn" href={manual.file} download>{t.manual.download(manual.size ?? '')}</a>
          <a class="btn btn--ghost" href={at(1)} target="_blank" rel="noopener">{t.manual.open}</a>
        </div>

        {
          lang === 'en' && (
            <p class="notice" style="margin-top:1.25rem;max-width:58ch;font-size:var(--fs-xs)">
              {LANG_NOTE}
            </p>
          )
        }

        <p class="muted" style="margin-top:1.25rem;font-size:var(--fs-xs);line-height:1.7">
          {t.manual.note}
        </p>
      </div>

      {
        compact ? (
          <ol class="manual-toc" data-reveal style="--d:.08s">
            {manual.chapters.map((c) => (
              <li>
                <a href={at(c.page)} target="_blank" rel="noopener">
                  <span class="no">{c.no}</span>
                  <span>{c.title}</span>
                  <span class="pg">{c.page}</span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="table-wrap" data-reveal style="--d:.08s">
            <table class="data">
              <thead>
                <tr>
                  <th scope="col">{t.manual.colNo}</th>
                  <th scope="col">{t.manual.colTitle}</th>
                  <th scope="col">{t.manual.colPage}</th>
                </tr>
              </thead>
              <tbody>
                {manual.chapters.map((c) => (
                  <tr>
                    <td class="num">{c.no}</td>
                    <td>
                      <a href={at(c.page)} target="_blank" rel="noopener">
                        {c.title}
                      </a>
                      {c.summary && (
                        <span
                          class="muted"
                          style="display:block;margin-top:.25rem;font-size:var(--fs-xs);line-height:1.65"
                        >
                          {c.summary}
                        </span>
                      )}
                      {c.keywords.length > 0 && (
                        <span class="cluster" style="margin-top:.45rem;gap:.3rem">
                          {c.keywords.map((k) => (
                            <span class="badge" style="font-size:.66rem;padding:.1rem .45rem">
                              {k}
                            </span>
                          ))}
                        </span>
                      )}
                    </td>
                    <td class="num">{c.page}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>
</section>
