---
import { getEntry } from 'astro:content';

const entry = await getEntry('profile', 'main');
const profile = entry?.data;
if (!profile) throw new Error('Nav 需要 profile 数据');

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isEn = path.startsWith('/en');

const links = [
  { href: '/', label: '主页' },
  { href: '/software', label: '软件' },
  { href: '/publications', label: '论文' },
  { href: '/notes', label: '笔记' },
  { href: '/about', label: '简历' },
];

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
};
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={isEn ? '/en/' : '/'}>
      {profile.name}
      <span class="brand__latin">{profile.name_en}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">菜单</span>
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
        <path d="M1 1h18M1 7h18M1 13h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>

    <nav class="nav" id="site-nav" aria-label="主导航">
      {
        links.map((l) => (
          <a
            class="nav__link"
            href={l.href}
            aria-current={!isEn && isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <span class="nav__divider" aria-hidden="true"></span>
      {
        isEn ? (
          <a class="lang-switch" href="/" hreflang="zh-CN" lang="zh-CN">
            中文
          </a>
        ) : (
          <a class="lang-switch" href="/en/" hreflang="en" lang="en">
            EN
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');

  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
