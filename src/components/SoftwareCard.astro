---
import { langFromPath, type Lang } from '../utils/i18n';
import { ui } from '../i18n/ui';

interface Props {
  item: {
    id: string;
    name: string;
    kicker: string;
    tagline: string;
    summary: string;
    version?: string;
    status?: string;
    /** 卡片底部的一行技术规格，例如 "FEM–MPM · 显式积分 · CUDA 多卡" */
    spec_line?: string;
    features: { title: string; text: string }[];
  };
  href: string;
  /** 是否使用深色卡片（深色媒体区里用） */
  tone?: 'light' | 'media';
  /** 语言；不传则按当前路径判断 */
  lang?: Lang;
}

const { item, href, tone = 'light' } = Astro.props;
const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);
const t = ui[lang];
---

<a
  class:list={['card', 'card--accent', { 'card--media': tone === 'media' }]}
  href={href}
  data-reveal
>
  <span class="card__meta">{item.kicker}{item.version && ` · ${item.version}`}</span>
  <span class="card__title">{item.name}</span>
  <span class="card__text">{item.tagline}</span>

  <ul class="feature-inline">
    {item.features.slice(0, 3).map((f) => <li>{f.title}</li>)}
  </ul>

  {item.spec_line && <span class="card__spec">{item.spec_line}</span>}

  <span class="card__cta">{t.common.cardDetails}</span>
</a>
