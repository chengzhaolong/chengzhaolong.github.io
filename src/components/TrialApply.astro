---
import { buildTrialMailto } from '../utils/trial';
import { langFromPath, withLang, type Lang } from '../utils/i18n';
import { ui } from '../i18n/ui';

interface Props {
  /** software.yml 的 application（英文页传 en 块里的那份） */
  app: {
    open: boolean;
    email: string;
    subject: string;
    lead?: string;
    fields: { k: string; hint?: string }[];
    extra_lines: string[];
    note?: string;
    mac_help: string[];
  };
  /** 软件名，用在标题里 */
  product: string;
  /** 语言；不传则按当前路径判断 */
  lang?: Lang;
}

const { app, product } = Astro.props;
const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);
const t = ui[lang];

const href = buildTrialMailto(app, lang === 'en' ? ': ' : '：');
const heading = app.open ? t.trial.headingOpen(product) : t.trial.headingSoon(product);
/** 开启后给一句「要准备什么」；还没开启时不写发放说明 */
const intro = app.open ? t.trial.intro : '';
/** 三块灰字都没有就整块不渲染，免得留一段空白 */
const hasNote = Boolean(intro || app.note || app.mac_help.length > 0);
---

<section class="section--tight section--line" id="access">
  <div class="container">
    <div class="apply" data-reveal>
      <span class="eyebrow">Access</span>
      <h2 style="margin-top:.65rem">{heading}</h2>
      {app.lead && <p style="margin-top:.75rem;max-width:62ch">{app.lead}</p>}

      <dl class="apply__fields">
        {
          app.fields.map((f) => (
            <div>
              <dt>{f.k}</dt>
              {f.hint && <dd>{f.hint}</dd>}
            </div>
          ))
        }
      </dl>

      <div class="cluster" style="margin-top:1.75rem">
        <a class="btn" href={href}>{app.open ? t.trial.apply : t.trial.register}</a>
        <a class="btn btn--ghost" href={withLang('/software', lang)}>{t.trial.back}</a>
      </div>

      {
        hasNote && (
          <div class="apply__note">
            {intro && <p>{intro}</p>}
            {app.note && <p>{app.note}</p>}
            {
              app.mac_help.length > 0 && (
                <ul>
                  <li>{t.trial.macHelp}</li>
                  {app.mac_help.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              )
            }
          </div>
        )
      }
    </div>
  </div>
</section>
