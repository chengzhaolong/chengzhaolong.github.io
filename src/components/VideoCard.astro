---
import { langFromPath, type Lang } from '../utils/i18n';
import { ui } from '../i18n/ui';

interface Props {
  /** mp4 路径（public/media/videos/…）；留空则只显示 poster 占位 */
  src?: string;
  webm?: string;
  /** 首帧图；不给则用占位云图 */
  poster?: string;
  alt: string;
  caption?: string;
  meta?: string;
  /** 图注里的中文标题（放在 meta 之前，可省略） */
  title?: string;
  /** 左上角角标，如「仿真 / 切削」 */
  badge?: string;
  /** 静音自动循环播放（默认开，滚出视口自动暂停）；传 false 则给控制器、点播 */
  autoplay?: boolean;
  placeholder?: 'a' | 'b' | 'c';
  placeholderLabel?: string;
  /** 画面比例，默认 16 / 9；宽幅可传 "21 / 9" */
  ratio?: string;
  /** 语言；不传则按当前路径判断 */
  lang?: Lang;
}

const {
  src,
  webm,
  poster,
  alt,
  caption,
  meta,
  title,
  badge,
  autoplay = true,
  placeholder = 'c',
  placeholderLabel,
  ratio = '16 / 9',
} = Astro.props;

const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);
const t = ui[lang];
/** 占位卡片上的提示行（默认值随语言变，所以不能写在解构默认值里） */
const label = placeholderLabel ?? t.a11y.placeholderVideo;

const phClass = placeholder === 'b' ? 'media-placeholder--b' : placeholder === 'c' ? 'media-placeholder--c' : '';
---

<figure class="figure" data-reveal>
  <div class="video-card">
    {
      src ? (
        <video
          class="video-card__video"
          style={`aspect-ratio:${ratio}`}
          poster={poster}
          muted
          loop
          playsinline
          preload={autoplay ? 'metadata' : 'none'}
          autoplay={autoplay}
          controls={!autoplay}
          aria-label={alt}
          data-auto={autoplay ? '' : undefined}
        >
          {webm && <source src={webm} type="video/webm" />}
          <source src={src} type="video/mp4" />
        </video>
      ) : (
        <div
          class={`media-placeholder ${phClass}`}
          role="img"
          aria-label={alt}
          style={`aspect-ratio:${ratio}`}
        >
          <span class="media-placeholder__grid" aria-hidden="true"></span>
          <span class="media-placeholder__label">
            <b>{t.a11y.placeholder}</b>
            {label}
          </span>
        </div>
      )
    }
    {badge && <span class="video-card__badge">{badge}</span>}
  </div>
  {(caption || meta || title) && (
    <figcaption class="figure__cap">
      {title && <span class="figure__title">{title}</span>}
      {meta && <span class="mono">{meta}</span>}
      {caption && <span>{caption}</span>}
    </figcaption>
  )}
</figure>

<script>
  // 自动播放的卡片视频只在视口内播放：进场就播，滚出去暂停，别让整页 6 个视频一起烧 CPU / 流量
  const autoVideos = document.querySelectorAll<HTMLVideoElement>('video[data-auto]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (autoVideos.length && (reduce || !('IntersectionObserver' in window))) {
    // 关掉动效偏好或不支持 observer：不自动播，换成控制器让访客自己点
    autoVideos.forEach((v) => {
      v.autoplay = false;
      v.pause();
      v.controls = true;
    });
  } else if (autoVideos.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            v.play().catch(() => {
              /* 浏览器策略拦下就保持 poster */
            });
          } else {
            v.pause();
          }
        });
      },
      { rootMargin: '200px 0px', threshold: 0.12 }
    );
    autoVideos.forEach((v) => io.observe(v));
  }
</script>
