---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import Motion from '../components/Motion.astro';
import { getEntry } from 'astro:content';
import { counterpartPath, type Lang } from '../utils/i18n';
import { ui } from '../i18n/ui';
import { profileText } from '../utils/localize';

interface Props {
  /** 页面标题，会自动拼成「标题 · 姓名」 */
  title?: string;
  description?: string;
  /** zh-CN（默认）/ en：决定 <html lang>、文案语言与 hreflang 配对 */
  lang?: 'zh-CN' | 'en';
  /** OG 图，默认 /og-image.png */
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  lang: rawLang = 'zh-CN',
  image = '/og-image.png',
  noindex = false,
} = Astro.props;

const entry = await getEntry('profile', 'main');
if (!entry) {
  throw new Error('缺少 src/data/profile.yml（collection: profile，条目 id: main）');
}
const profile = entry.data;

const lang: Lang = rawLang === 'en' ? 'en' : 'zh';
const htmlLang = lang === 'en' ? 'en' : 'zh-CN';
const t = ui[lang];
const pt = profileText(profile, lang);

const siteName = pt.name;
const suffix = pt.siteSuffix;
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · ${suffix}`;
const desc =
  description ??
  (lang === 'en'
    ? `${pt.tagline}. ${pt.interests.join(', ')}.`
    : `${profile.tagline_zh}。${profile.interests.join('、')}。`);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
/** hreflang 互相配对：有英文镜像就指到同一页，没有则退回对应语言首页 */
const zhHref = new URL(counterpartPath(Astro.url.pathname, 'zh'), Astro.site).href;
const enHref = new URL(counterpartPath(Astro.url.pathname, 'en'), Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: pt.name,
  alternateName: lang === 'en' ? profile.name : profile.name_en,
  jobTitle: pt.title,
  affiliation: { '@type': 'Organization', name: pt.affiliation },
  url: canonical,
  email: profile.email ? `mailto:${profile.email}` : undefined,
  knowsAbout: pt.interests,
  // sameAs 只收绝对 URL（schema.org 语义）：站内相对路径如 /media/docs/cv.pdf 不能放进来
  sameAs: Object.values(profile.links ?? {}).filter(
    (v): v is string => typeof v === 'string' && /^https?:\/\//.test(v)
  ),
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 入场动效只在 JS 可用时启用：禁用 JS 时内容必须可见 -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0d" />

    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={zhHref} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={lang === 'en' ? profile.name_en : `${profile.name} · ${profile.name_en}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <slot name="head" />
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <Lightbox lang={lang} />
    <Motion />
  </body>
</html>
