---
import Base from '../layouts/Base.astro';
---

<Base title="404 · 页面不存在" noindex>
  <section class="section" style="min-height:68vh;display:grid;place-items:center;text-align:center">
    <div class="container--narrow">
      <p class="eyebrow" style="justify-content:center">Error 404</p>
      <h1 class="display" style="margin-top:1rem">这条路径没有解</h1>
      <p class="lead" style="margin-top:1.1rem">
        页面可能被移动、改名，或者从来没存在过。要不换个初始条件重新算一次？
      </p>
      <div class="cluster" style="margin-top:2rem;justify-content:center">
        <a class="btn" href="/">回到首页</a>
        <a class="btn btn--ghost" href="/research">研究方向</a>
        <a class="btn btn--ghost" href="/publications">论文</a>
      </div>
    </div>
  </section>
</Base>
