---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';

const profile = (await getEntry('profile', 'main'))!.data;
const cv = (await getEntry('cv', 'main'))!.data;

/** 页首一句话：cv.yml 没写（或写了空串）就退回 profile 的简介 */
const summary = cv.summary?.trim() ? cv.summary : profile.intro_zh;

/** 姓名下面那行：身份 · 单位 · 地点 */
const meta = [profile.title, profile.affiliation, profile.location].filter(Boolean);

/** 联系方式：只渲染填了的 */
const contacts = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: 'ORCID ↗', href: profile.links?.orcid },
  { label: 'Scholar ↗', href: profile.links?.scholar },
  { label: 'GitHub ↗', href: profile.links?.github },
  { label: 'Bilibili ↗', href: profile.links?.bilibili },
].filter((c) => c.href);
---

<Base title="简历" description={`${profile.name}，${profile.title}，${profile.affiliation}。简历：教育背景、项目经历、获奖与技能。`}>
  <header class="page-head">
    <div class="container--narrow">
      <span class="eyebrow">CV · 简历</span>
      <h1 class="page-head__title">{profile.name}</h1>
      <p class="cv-meta mono">{meta.join(' · ')}</p>
      <ul class="cv-contact mono">
        {
          contacts.map((c) => (
            <li>
              <a href={c.href}>{c.label}</a>
            </li>
          ))
        }
      </ul>
      {
        profile.links?.cv && (
          <div class="cluster" style="margin-top:1.35rem">
            <a class="btn btn--ghost" href={profile.links.cv}>
              下载 CV（PDF）
            </a>
          </div>
        )
      }
    </div>
  </header>

  <section class="section">
    <div class="container--narrow">
      {summary && <p class="lead cv-summary">{summary}</p>}

      {
        cv.education.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">教育背景</h2>
            <ol class="timeline">
              {cv.education.map((e) => (
                <li class="timeline__item">
                  <span class="timeline__when">{e.period}</span>
                  <p class="timeline__what">
                    {e.degree}
                    {e.major && ` · ${e.major}`}
                  </p>
                  <p class="timeline__where">{e.school}</p>
                  {e.note && <p class="timeline__desc">{e.note}</p>}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        cv.projects.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">项目经历</h2>
            <ol class="timeline">
              {cv.projects.map((p) => (
                <li class="timeline__item">
                  <span class="timeline__when">{p.period}</span>
                  <p class="timeline__what">{p.name}</p>
                  {p.role && <p class="timeline__where">{p.role}</p>}
                  <p class="timeline__desc">{p.text}</p>
                  {(p.tags?.length || p.link) && (
                    <div class="cv-tags">
                      {p.tags?.map((t) => (
                        <span class="badge">{t}</span>
                      ))}
                      {p.link && (
                        <a class="badge" href={p.link}>
                          详情 →
                        </a>
                      )}
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        cv.awards.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">获奖与荣誉</h2>
            <ul class="cv-awards">
              {cv.awards.map((a) => (
                <li>
                  <span class="cv-awards__when mono">{a.period}</span>
                  <span class="cv-awards__title">{a.title}</span>
                  {a.note && <span class="cv-awards__note">{a.note}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        cv.skills.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">工具与技能</h2>
            <div class="table-wrap">
              <table class="data">
                <tbody>
                  {cv.skills.map((s) => (
                    <tr>
                      <th scope="row">{s.group}</th>
                      <td>{s.items}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      <p class="cv-links mono">
        <a href="/publications">论文列表 →</a>
        <a href="/software">软件 →</a>
        <a href="/notes">笔记 →</a>
      </p>
    </div>
  </section>
</Base>
