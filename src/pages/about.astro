---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';

const profile = (await getEntry('profile', 'main'))!.data;
const cv = (await getEntry('cv', 'main'))!.data;

/** 姓名下面第一行：身份 · 单位 · 地点 */
const meta = [profile.affiliation].filter(Boolean);

/** 姓名下面第二行：只渲染填了的联系方式 */
const contacts = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: 'ORCID ↗', href: profile.links?.orcid },
  { label: 'Scholar ↗', href: profile.links?.scholar },
  { label: 'GitHub ↗', href: profile.links?.github },
  { label: 'Bilibili ↗', href: profile.links?.bilibili },
  // 简历 PDF 走下载而不是浏览器预览（文件在 public/media/docs/cv.pdf）
  { label: 'CV（PDF）↓', href: profile.links?.cv, download: true },
].filter((c) => c.href);
---

<Base
  title="简历"
  description={`${profile.name}，${profile.title}，${profile.affiliation}。简历：教育背景、项目经历、获奖、技能。`}
>
  <header class="cv-head">
    <div class="container--cv cv-head__inner">
      <div class="cv-head__main">
        <h1 class="cv-name">{profile.name}</h1>
        <p class="cv-line">{meta.join(' · ')}</p>
        <p class="cv-line cv-line--links">
          {
            contacts.map((c, i) => (
              <>
                {i > 0 && (
                  <span aria-hidden="true" class={c.download ? 'cv-line__sep--cv' : undefined}>
                    ·
                  </span>
                )}
                <a href={c.href} download={c.download} class={c.download ? 'cv-line__cv' : undefined}>
                  {c.label}
                </a>
              </>
            ))
          }
        </p>
      </div>
      {
        profile.photo && (
          /* 照片只出现在打印出的 PDF 里：屏幕上 display:none，不占位 */
          <img class="cv-photo" src={profile.photo} alt={`${profile.name}的照片`} width="88" height="118" />
        )
      }
    </div>
  </header>

  <section class="cv-body">
    <div class="container--cv">
      {
        cv.education.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">教育与经历</h2>
            {cv.education.map((e) => (
              <div class="cv-entry">
                <div class="cv-entry__head">
                  <p class="cv-entry__title">
                    {[e.school, e.major, e.degree].filter(Boolean).join('，')}
                  </p>
                  <span class="cv-entry__when">{e.period}</span>
                </div>
                {e.points.length > 0 && (
                  <ul class="cv-list">
                    {e.points.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </section>
        )
      }

      {
        cv.projects.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">项目</h2>
            {cv.projects.map((p) => (
              <div class="cv-entry">
                <div class="cv-entry__head">
                  <p class="cv-entry__title">
                    {p.name}
                    {p.role && <span class="cv-entry__role">{p.role}</span>}
                  </p>
                  <span class="cv-entry__when">{p.period}</span>
                </div>
                {p.points.length > 0 && (
                  <ul class="cv-list">
                    {p.points.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </section>
        )
      }

      {
        cv.awards.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">获奖与荣誉</h2>
            {cv.awards.map((a) => (
              <div class="cv-row">
                <p class="cv-row__title">
                  {a.title}
                  {a.note && <span class="cv-row__note">{a.note}</span>}
                </p>
                <span class="cv-entry__when">{a.period}</span>
              </div>
            ))}
          </section>
        )
      }

      {
        cv.skills.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">工具与技能</h2>
            <dl class="cv-skills">
              {cv.skills.map((s) => (
                <>
                  <dt>{s.group}</dt>
                  <dd>{s.items}</dd>
                </>
              ))}
            </dl>
          </section>
        )
      }

      <p class="cv-links mono">
        <a href="/publications">论文列表 →</a>
        <a href="/software">软件 →</a>
        <a href="/notes">笔记 →</a>
      </p>
    </div>
  </section>
</Base>
