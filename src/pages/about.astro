---
/**
 * 简历页（中文）。正文在 components/CvSheet.astro，英文页 /en/about 复用同一份结构。
 */
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import CvSheet from '../components/CvSheet.astro';

const profile = (await getEntry('profile', 'main'))!.data;
---

<Base
  title="简历"
  description={`${profile.name}，${profile.title}，${profile.affiliation}。简历：教育背景、项目经历、论文与专利、技能。`}
>
  <CvSheet lang="zh" />
</Base>
