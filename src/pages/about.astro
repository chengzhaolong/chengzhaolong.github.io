---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

const profile = (await getEntry('profile', 'main'))!.data;
const cv = (await getEntry('cv', 'main'))!.data;

/** 论文与专利：和 /publications 同一份数据，年份倒序、置顶优先，简历里全列 */
const pubs = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || Number(b.data.highlight) - Number(a.data.highlight)
);

/** 作者行：本人姓名加粗（先转义再拼 HTML，写法同 PubItem） */
const me = profile.name_en;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const authorsHtml = (authors: string[]) =>
  authors.map((a) => (a.trim() === me ? `<b class="cv-pub__me">${esc(a)}</b>` : esc(a))).join(', ');

/** 期刊用短名（IJNME），专利写成「中国发明专利（CN121031225B）」 */
const venueOf = (p: (typeof pubs)[number]['data']) =>
  p.type === 'patent' && p.venue_short ? `${p.venue}（${p.venue_short}）` : (p.venue_short ?? p.venue);

/** 姓名下面第一行：身份 · 单位 · 地点 */
const meta = [profile.affiliation].filter(Boolean);

/** 姓名下面第二行：只渲染填了的联系方式 */
const contacts = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: 'ORCID ↗', href: profile.links?.orcid },
  { label: 'Scholar ↗', href: profile.links?.scholar },
  { label: 'GitHub ↗', href: profile.links?.github },
  { label: 'Bilibili ↗', href: profile.links?.bilibili },
  // 简历 PDF 走下载而不是浏览器预览（文件在 public/media/docs/cv.pdf）
  { label: '下载简历（PDF）↓', href: profile.links?.cv, download: true },
].filter((c) => c.href);

/** 页首「想了解更多」那行：只在打印出的 PDF 里出现，网址去掉 https:// 好排版 */
const cuspicUrl = profile.links?.cuspic;
const cuspicLabel = cuspicUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<Base
  title="简历"
  description={`${profile.name}，${profile.title}，${profile.affiliation}。简历：教育背景、项目经历、论文与专利、技能。`}
>
  <header class="cv-head">
    <div class="container--cv cv-head__inner">
      <div class="cv-head__main">
        <h1 class="cv-name">{profile.name}</h1>
        <p class="cv-line">{meta.join(' · ')}</p>
        <p class="cv-line cv-line--links">
          {
            contacts.map((c, i) => (
              <>
                {i > 0 && (
                  <span aria-hidden="true" class={c.download ? 'cv-line__sep--cv' : undefined}>
                    ·
                  </span>
                )}
                <a href={c.href} download={c.download} class={c.download ? 'cv-line__cv' : undefined}>
                  {c.label}
                </a>
              </>
            ))
          }
        </p>
        {
          cuspicUrl && (
            <p class="cv-line cv-line--home">
              查看我的个人主页，了解更多我的背景和CUSPIC求解器：
              <a class="cv-home__url" href={cuspicUrl}>
                {cuspicLabel}
              </a>
            </p>
          )
        }
      </div>
      {
        profile.photo && (
          /* 照片只出现在打印出的 PDF 里：屏幕上 display:none，不占位 */
          <img class="cv-photo" src={profile.photo} alt={`${profile.name}的照片`} width="88" height="118" />
        )
      }
    </div>
  </header>

  <section class="cv-body">
    <div class="container--cv">
      {
        cv.education.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">教育与经历</h2>
            {cv.education.map((e) => (
              <div class="cv-entry">
                <div class="cv-entry__head">
                  <p class="cv-entry__title">
                    {[e.school, e.major, e.degree].filter(Boolean).join('，')}
                  </p>
                  <span class="cv-entry__when">{e.period}</span>
                </div>
                {e.points.length > 0 && (
                  <ul class="cv-list">
                    {e.points.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </section>
        )
      }

      {
        cv.projects.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">项目</h2>
            {cv.projects.map((p) => (
              <div class="cv-entry">
                <div class="cv-entry__head">
                  <p class="cv-entry__title">
                    {p.name}
                    {p.role && <span class="cv-entry__role">{p.role}</span>}
                  </p>
                  <span class="cv-entry__when">{p.period}</span>
                </div>
                {p.points.length > 0 && (
                  <ul class="cv-list">
                    {p.points.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </section>
        )
      }

      {
        pubs.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">论文与专利</h2>
            <ol class="cv-pubs">
              {pubs.map((pub) => {
                const d = pub.data;
                const isPatent = d.type === 'patent';
                const venue = venueOf(d);
                return (
                  <li>
                    <span set:html={authorsHtml(d.authors)} />.{' '}
                    {d.title}.{' '}
                    {isPatent && <span class="cv-pub__tag">专利</span>}
                    <span class="cv-pub__venue">
                      {isPatent ? venue : <em>{venue}</em>}, {d.year}
                    </span>
                    {d.status && <span class="cv-pub__note"> · {d.status}</span>}
                  </li>
                );
              })}
            </ol>
          </section>
        )
      }

      {
        cv.skills.length > 0 && (
          <section class="cv-block">
            <h2 class="cv-block__title">工具与技能</h2>
            <dl class="cv-skills">
              {cv.skills.map((s) => (
                <>
                  <dt>{s.group}</dt>
                  <dd>{s.items}</dd>
                </>
              ))}
            </dl>
          </section>
        )
      }

      <p class="cv-links mono">
        <a href="/publications">论文列表 →</a>
        <a href="/software">软件 →</a>
        <a href="/notes">笔记 →</a>
      </p>
    </div>
  </section>
</Base>
