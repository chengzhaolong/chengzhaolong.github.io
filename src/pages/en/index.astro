---
/**
 * Home (English). 正文用与中文首页同一个 HomeBody，结构永远不会走形。
 */
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';
import HomeBody from '../../components/HomeBody.astro';
import { profileText } from '../../utils/localize';

const profile = (await getEntry('profile', 'main'))!.data;
const pt = profileText(profile, 'en');
---

<Base
  lang="en"
  description={`${pt.tagline} Author of CUSPIC and CUSPER CuttingLab — ${pt.interests.slice(0, 3).join(', ')}.`}
>
  <HomeBody lang="en" />
</Base>
