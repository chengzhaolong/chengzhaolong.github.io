---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

const profile = (await getEntry('profile', 'main'))!.data;
const notes = (await getCollection('notes'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const pubs = (await getCollection('publications'))
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 5);
const software = await getCollection('software');

const bioParagraphs = profile.intro_en.split('\n\n');
---

<Base
  lang="en"
  title="CUSPIC · FEM–MPM cutting simulation"
  description="Author of CUSPIC, a GPU-accelerated FEM–MPM solver for large-deformation thermo-mechanical metal cutting simulation."
>
  <header class="page-head page-head--media">
    <div class="hero__media">
      <img src="/media/hero-contour.svg" alt="" width="1600" height="900" />
    </div>
    <div class="container page-head__inner">
      <p class="eyebrow eyebrow--media">Computational Mechanics · FEM–MPM · GPU</p>
      <h1 class="page-head__title" style="font-size:clamp(1.9rem,3.4vw,2.5rem)">
        {profile.name_en}
      </h1>
      <p class="page-head__lede" style="font-size:1.1rem">
        {profile.role_short_en ?? profile.title_en} · {profile.affiliation_en}
      </p>
      <div class="cluster" style="margin-top:1.25rem">
        {profile.interests.slice(0, 4).map((i) => <span class="badge badge--media">{i}</span>)}
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container--narrow">
      <span class="eyebrow">About</span>
      <div class="prose" style="margin-top:1rem">
        {bioParagraphs.map((p) => <p>{p}</p>)}
      </div>

      <div class="cluster" style="margin-top:1.75rem">
        <a class="btn" href={`mailto:${profile.email}`}>Email</a>
        {profile.links?.scholar && <a class="btn btn--ghost" href={profile.links.scholar}>Google Scholar</a>}
        {profile.links?.github && <a class="btn btn--ghost" href={profile.links.github}>GitHub</a>}
      </div>
    </div>
  </section>

  {
    notes.length > 0 && (
  <section class="section--tight section--line">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <span class="eyebrow">Notes</span>
          <h2 style="margin-top:.6rem">Technical notes</h2>
          <p>Design trade-offs, failed attempts and the numbers behind the papers. Written in Chinese.</p>
        </div>
        <a class="btn btn--ghost" href="/notes">All notes →</a>
      </div>

      <div class="card-grid card-grid--2">
        {
          notes.map((n) => (
            <a class="card card--accent" href={`/notes/${n.id}`} data-reveal>
              <span class="card__meta">{n.data.date.toISOString().slice(0, 10)}</span>
              <span class="card__title">{n.data.title}</span>
              <span class="card__text">{n.data.summary}</span>
              <span class="card__cta">Read</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
    )
  }

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <span class="eyebrow">Software</span>
          <h2 style="margin-top:.6rem">Software</h2>
        </div>
      </div>
      <div class="card-grid card-grid--2">
        {software.map((s) => (
          <a class="card card--accent" href={`/software/${s.id}`} data-reveal>
            <span class="card__meta">{s.data.kicker}</span>
            <span class="card__title">{s.data.name}</span>
            <span class="card__text">{s.data.tagline}</span>
            <span class="card__cta">Details</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="media-band">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <span class="eyebrow eyebrow--media">Publications</span>
          <h2 style="margin-top:.6rem">Selected publications</h2>
          <p>Full list (with BibTeX) on the Chinese publications page.</p>
        </div>
        <a class="btn btn--media-ghost" href="/publications">All publications →</a>
      </div>

      <ul class="en-pubs">
        {pubs.map((p) => (
          <li>
            <p class="en-pubs__title">{p.data.title}</p>
            <p class="en-pubs__meta">
              {p.data.authors.join(', ')} · <em>{p.data.venue_short ?? p.data.venue}</em>, {p.data.year}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section style="padding-block:0">
    <div class="container">
      <div class="contact-strip">
        <span class="contact-strip__label">Contact</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <span class="contact-strip__sep" aria-hidden="true">·</span>
        <a href="/publications">Publications</a>
        {
          profile.links?.cv && (
            <>
              <span class="contact-strip__sep" aria-hidden="true">
                ·
              </span>
              <a href={profile.links.cv} download>CV (PDF)</a>
            </>
          )
        }
      </div>
    </div>
  </section>
</Base>
