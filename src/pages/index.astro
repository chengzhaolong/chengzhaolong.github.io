---
/**
 * 首页（中文）。正文在 components/HomeBody.astro，英文页 /en 复用同一份结构。
 */
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import HomeBody from '../components/HomeBody.astro';

const profile = (await getEntry('profile', 'main'))!.data;
---

<Base
  description={`${profile.name}：${profile.tagline_zh}。CUSPIC 求解器与 CUSPER CuttingLab 作者，${profile.interests
    .slice(0, 3)
    .join('、')}。`}
>
  <HomeBody lang="zh" />
</Base>
