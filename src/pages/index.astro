---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import VideoCard from '../components/VideoCard.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import PubItem from '../components/PubItem.astro';

const profile = (await getEntry('profile', 'main'))!.data;
const software = await getCollection('software');
const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const featured = [...pubs.filter((p) => p.data.highlight), ...pubs.filter((p) => !p.data.highlight)].slice(0, 3);

const contactHref = `mailto:${profile.email}`;
const portrait = profile.photo ?? '/media/portrait.svg';
---

<Base
  description={`${profile.name}：${profile.tagline_zh}。CUSPIC 求解器与 CUSPER CuttingLab 作者，${profile.interests
    .slice(0, 3)
    .join('、')}。`}
>
  <!-- ============ 首屏：姓名退后，照片与工作在前 ============ -->
  <section class="hero">
    <div class="hero__media">
      <img src="/media/hero-contour.svg" alt="" width="1600" height="900" fetchpriority="high" />
    </div>

    <div class="hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">热力耦合 · 高性能 · 非线性 · CAE求解器</p>
        <h1 class="hero__title">{profile.name}</h1>
        <p class="hero__lede">{profile.tagline_zh}</p>

        <p class="link-row">
          {
            profile.show_notes && (
              <>
                <a href="/notes">笔记</a>
                <span class="link-row__sep" aria-hidden="true">·</span>
              </>
            )
          }
          <a href="/software">软件</a>
          <span class="link-row__sep" aria-hidden="true">·</span>
          <a href="/publications">论文</a>
          <span class="link-row__sep" aria-hidden="true">·</span>
          <a href={contactHref}>邮箱</a>
        </p>
      </div>

      <a class="hero__portrait" href="/about" aria-label={`${profile.name} 的简历`}>
        <img src={portrait} alt={`${profile.name}的照片`} width="600" height="800" />
      </a>
    </div>
  </section>

  <!-- ============ 简介 + 算例（视频代替简历摘要） ============ -->
  <section class="section" id="intro">
    <div class="container">
      <div class="split split--top">
        <div data-reveal>
          <span class="eyebrow">简介</span>
          <p class="lead" style="margin-top:1rem">{profile.intro_zh}</p>
          <div class="cluster" style="margin-top:1.35rem">
            {profile.interests.map((i) => <span class="badge">{i}</span>)}
          </div>
          <p style="margin-top:1.5rem">
            <a class="link-quiet" href="/about">完整介绍与简历 →</a>
          </p>
        </div>

        <div class="case-mini" data-reveal style="--d:.08s">
          <span class="eyebrow">算例</span>
          <VideoCard
            src="/media/videos/cut3d1.mp4"
            poster="/media/videos/cut3d1.jpg"
            autoplay
            alt="CUSPIC案例：三维微铣削仿真（FEM-MPM热力耦合）"
            badge="cuspic"
            caption="CUSPIC案例：三维微铣削仿真（FEM-MPM热力耦合）"
            meta="Simulation"
            placeholder="c"
            placeholderLabel="切削仿真循环短片"
            ratio="16 / 9"
          />

          <p class="case-mini__link">
            <a class="link-quiet" href="/software/cuspic">了解 CUSPIC 求解器，用消费级 GPU 把 FEM–MPM 热力耦合切削仿真加速 50 倍 →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 自研工具（深色） ============ -->
  <section class="media-band">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <span class="eyebrow eyebrow--media">软件</span>
          <h2 style="margin-top:.65rem">自研工具</h2>
          <p>基于高性能FEM-MPM算法，加速制造工艺改进</p>
        </div>
        <a class="btn btn--media-ghost" href="/software">软件总览 →</a>
      </div>

      <div class="card-grid card-grid--2">
        {
          software.map((s) => (
            <SoftwareCard item={{ ...s.data, id: s.id }} href={`/software/${s.id}`} tone="media" />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ 论文 ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <span class="eyebrow">Publications</span>
          <h2 style="margin-top:.65rem">Publications</h2>
        </div>
        <a class="btn btn--ghost" href="/publications">全部论文 →</a>
      </div>

      <ul class="pub-list">
        {featured.map((p, i) => <PubItem pub={{ ...p.data, id: p.id }} index={i + 1} />)}
      </ul>
    </div>
  </section>

  <!-- ============ 联系（一行，不用大 CTA） ============ -->
  <section style="padding-block:0">
    <div class="container">
      <div class="contact-strip">
        <span class="contact-strip__label">联系</span>
        <a href={contactHref}>{profile.email}</a>
        {
          profile.links?.cv && (
            <>
              <span class="contact-strip__sep" aria-hidden="true">
                ·
              </span>
              <a href={profile.links.cv} download>CV（PDF）</a>
            </>
          )
        }
        <span class="contact-strip__sep" aria-hidden="true">·</span>
        <a href="/software/cuttinglab#access">CUSPER CuttingLab 试用即将开启</a>
      </div>
    </div>
  </section>
</Base>
