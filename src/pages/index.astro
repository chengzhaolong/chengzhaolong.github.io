---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import FigureCard from '../components/FigureCard.astro';
import VideoCard from '../components/VideoCard.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import PubItem from '../components/PubItem.astro';

const profile = (await getEntry('profile', 'main'))!.data;
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const software = await getCollection('software');
const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const featured = [...pubs.filter((p) => p.data.highlight), ...pubs.filter((p) => !p.data.highlight)].slice(0, 3);

const now = profile.timeline[0];
const contactHref = `mailto:${profile.email}`;
---

<Base
  description={`${profile.name}，${profile.title}，${profile.affiliation}。研究方向：${profile.interests
    .slice(0, 4)
    .join('、')}。`}
>
  <!-- ============ 首屏：姓名退后，工作在前 ============ -->
  <section class="hero">
    <div class="hero__media">
      <img src="/media/hero-contour.svg" alt="" width="1600" height="900" fetchpriority="high" />
    </div>

    <div class="hero__inner">
      <p class="hero__eyebrow">FEM–MPM · 切削仿真 · GPU</p>
      <h1 class="hero__title">{profile.name}</h1>
      <p class="hero__affil">{profile.title} · {profile.affiliation}</p>
      <p class="hero__lede">{profile.tagline_zh}</p>

      <p class="link-row">
        <a href="/research">研究方向</a>
        <span class="link-row__sep" aria-hidden="true">·</span>
        <a href="/software">软件</a>
        <span class="link-row__sep" aria-hidden="true">·</span>
        <a href="/publications">论文</a>
        <span class="link-row__sep" aria-hidden="true">·</span>
        <a href={contactHref}>邮箱</a>
      </p>
    </div>

    <p class="hero__note">cuspic 正交切削算例 · 切屑形成与温度场（待替换为真实结果帧）</p>
  </section>

  <!-- ============ 简介 + 简历摘要 ============ -->
  <section class="section" id="intro">
    <div class="container">
      <div class="split split--top">
        <div data-reveal>
          <span class="eyebrow">简介</span>
          <p class="lead" style="margin-top:1rem">{profile.intro_zh}</p>
          <div class="cluster" style="margin-top:1.35rem">
            {profile.interests.map((i) => <span class="badge">{i}</span>)}
          </div>
          <p style="margin-top:1.5rem">
            <a class="link-quiet" href="/about">完整介绍与简历 →</a>
          </p>
        </div>

        <aside data-reveal style="--d:.08s">
          <p class="card__meta" style="display:block;margin-bottom:.9rem">简历摘要</p>
          <dl class="cv-list">
            <div>
              <dt>现在</dt>
              <dd>
                {now.what}
                <span>{now.where} · {now.when}</span>
              </dd>
            </div>
            <div>
              <dt>在做</dt>
              <dd>
                cuspic —— FEM–MPM / GPU 求解器
                <span>Cusper CuttingLab —— 金属切削仿真软件</span>
              </dd>
            </div>
            <div>
              <dt>关注</dt>
              <dd>
                接触与摩擦 · 材料本构与断裂
                <span>可复现的验证算例</span>
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============ 研究方向（行列表） ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <span class="eyebrow">研究方向</span>
          <h2 style="margin-top:.65rem">在解的问题</h2>
          <p>从物理建模到数值方法，再到并行实现，最后落到能用的软件。</p>
        </div>
        <a class="btn btn--ghost" href="/research">全部方向 →</a>
      </div>

      <ul class="idx-list">
        {research.map((r, i) => (
          <li>
            <a
              class="idx-list__item"
              href={`/research/${r.id}`}
              data-reveal
              style={`--d:${i * 0.05}s`}
            >
              <span class="idx-list__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="idx-list__title">{r.data.title}</span>
              <span class="idx-list__text">{r.data.summary.replace(/。\s*$/, '')}</span>
              <span class="idx-list__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 算例（深色，重点展示） ============ -->
  <section class="media-band" id="cases">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <span class="eyebrow eyebrow--media">算例</span>
          <h2 style="margin-top:.65rem">三个代表性算例</h2>
          <p>切屑形成、温度场与力–时间曲线。下面四块媒体待替换为实测结果。</p>
        </div>
        <a class="btn btn--media-ghost" href="/research/cutting">切削方向 →</a>
      </div>

      <div class="media-grid">
        <div class="span-12">
          <VideoCard
            alt="金属切削过程仿真动画：切屑形成与温度演化"
            badge="Simulation"
            caption="正交切削：切屑形成与温度演化。替换为你的循环短片（720p / 5–10 s / 3 MB 以内）。"
            meta="Animation · 待替换"
            placeholder="c"
            placeholderLabel="替换：切削仿真循环短片（mp4）"
            ratio="21 / 9"
          />
        </div>
        <div class="span-4">
          <FigureCard
            alt="切削温度场云图"
            caption="温度场分布，最高温出现在刀–屑接触区。"
            meta="Temperature · 待替换"
            placeholder="b"
            placeholderLabel="替换：温度场云图"
            ratio="1 / 1"
          />
        </div>
        <div class="span-4">
          <FigureCard
            alt="等效塑性应变云图"
            caption="等效塑性应变：主剪切带的局部化与切屑分离。"
            meta="PEEQ · 待替换"
            placeholder="a"
            placeholderLabel="替换：等效塑性应变云图"
            ratio="1 / 1"
          />
        </div>
        <div class="span-4">
          <FigureCard
            alt="切削力与温度随时间变化曲线"
            caption="切削力与最高温度的时间曲线，稳态段用于工艺对比。"
            meta="Force / Temperature · 待替换"
            placeholder="c"
            placeholderLabel="替换：力–时间 / 温度–时间曲线"
            ratio="1 / 1"
          />
        </div>
      </div>

      {
        profile.metrics.length > 0 && (
          <dl class="metric-strip">
            {profile.metrics.map((m) => (
              <div>
                <dt class="metric-strip__k">{m.k}</dt>
                <dd class="metric-strip__v">{m.v}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <!-- ============ 自研工具（深色） ============ -->
  <section class="media-band">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <span class="eyebrow eyebrow--media">软件</span>
          <h2 style="margin-top:.65rem">自研工具</h2>
          <p>底层是 cuspic，上层是 Cusper CuttingLab：一个管精度与速度，一个管流程与可用性。</p>
        </div>
        <a class="btn btn--media-ghost" href="/software">软件总览 →</a>
      </div>

      <div class="card-grid card-grid--2">
        {
          software.map((s) => (
            <SoftwareCard item={{ ...s.data, id: s.id }} href={`/software/${s.id}`} tone="media" />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ 论文 ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <span class="eyebrow">论文</span>
          <h2 style="margin-top:.65rem">代表性论文</h2>
          <p>完整列表含 BibTeX、DOI 与代码链接。</p>
        </div>
        <a class="btn btn--ghost" href="/publications">全部论文 →</a>
      </div>

      <ul class="pub-list">
        {featured.map((p, i) => <PubItem pub={{ ...p.data, id: p.id }} index={i + 1} />)}
      </ul>
    </div>
  </section>

  <!-- ============ 联系（一行，不用大 CTA） ============ -->
  <section style="padding-block:0">
    <div class="container">
      <div class="contact-strip">
        <span class="contact-strip__label">联系</span>
        <a href={contactHref}>{profile.email}</a>
        {
          profile.links?.cv && (
            <>
              <span class="contact-strip__sep" aria-hidden="true">
                ·
              </span>
              <a href={profile.links.cv}>CV（PDF）</a>
            </>
          )
        }
        <span class="contact-strip__sep" aria-hidden="true">·</span>
        <a href={`${contactHref}?subject=Cusper%20CuttingLab%20试用申请`}>申请 CuttingLab 试用</a>
      </div>
    </div>
  </section>
</Base>
