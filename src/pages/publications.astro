---
/**
 * 论文列表（中文）。正文在 components/PublicationsBody.astro，英文页 /en/publications 复用同一份结构。
 */
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import PublicationsBody from '../components/PublicationsBody.astro';

const profile = (await getEntry('profile', 'main'))!.data;
---

<Base
  title="论文"
  description={`${profile.name}的论文列表：大变形热力耦合、FEM–MPM 耦合与 GPU 并行计算方向的研究成果。`}
>
  <PublicationsBody lang="zh" />
</Base>
