---
/**
 * 软件详情（中文）。正文在 components/SoftwareDetail.astro，英文页 /en/software/[slug] 复用同一份结构。
 */
import { getCollection } from 'astro:content';
import SoftwareDetail from '../../components/SoftwareDetail.astro';

export async function getStaticPaths() {
  const items = await getCollection('software');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<SoftwareDetail lang="zh" entry={entry} />
