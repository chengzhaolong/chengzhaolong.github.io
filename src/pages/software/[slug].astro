---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import CaseGallery from '../../components/CaseGallery.astro';
import ManualDocs from '../../components/ManualDocs.astro';
import TrialApply from '../../components/TrialApply.astro';

export async function getStaticPaths() {
  const items = await getCollection('software');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const s = entry.data;
const profile = (await getEntry('profile', 'main'))!.data;
const email = profile.email;
/** CUSPIC 配一本 86 页用户手册；CuttingLab 暂无 */
const manual = entry.id === 'cuspic' ? (await getEntry('manual', 'cuspic'))?.data : undefined;
/** 〔待填〕的行不上页面 */
const specs = s.specs.filter((row) => !row.v.includes('〔'));

/**
 * CuttingLab 的工作流：写的是已经跑通的二维正交切削链路；
 * 三维工况沿用同一套步骤，按 software.yml 的 roadmap 逐步接入。
 */
const workflow = [
  { when: 'Step 1', what: '参数化建模', desc: '工件、刀具与刀尖几何参数化，材料本构与摩擦模型集中设置，改参数即可重建算例。' },
  { when: 'Step 2', what: '网格划分', desc: '自动布置背景网格与物质点，切削区局部加密；三维钻削的网格模块同样可用。' },
  { when: 'Step 3', what: '生成输入文件', desc: '输出 CUSPIC 可读的关键字输入文件，不用手写卡片，前处理脚本交给软件。' },
  { when: 'Step 4', what: '求解', desc: '在界面内调用 CUSPIC（FEM–MPM），时间步控制与任务调度由软件接管。' },
  { when: 'Step 5', what: '实时后处理', desc: '云图与切削力时程曲线随计算刷新，结果可导出图片与数据。' },
];
---

<Base title={s.name} description={s.tagline}>
  <header class="page-head page-head--media">
    <div class="hero__media">
      <img src="/media/hero-contour.svg" alt="" width="1600" height="900" />
    </div>
    <div class="container page-head__inner">
      <nav class="crumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span aria-hidden="true">/</span>
        <a href="/software">软件</a>
      </nav>
      <p class="eyebrow eyebrow--media" style="margin-top:1.25rem">{s.kicker}{s.version && ` · ${s.version}`}</p>
      <h1 class="page-head__title">{s.name}</h1>
      <p class="page-head__lede">{s.tagline}</p>
      <div class="cluster" style="margin-top:1.25rem">
        {s.status && <span class="badge badge--media badge--dot">{s.status}</span>}
        {s.chips.map((chip) => <span class="badge badge--media">{chip}</span>)}
      </div>
      <div class="cluster" style="margin-top:1.5rem">
        {s.links.map((l) => (
          <a
            class:list={['btn', l.variant === 'primary' ? 'btn--media' : 'btn--media-ghost']}
            href={l.href}
            download={l.download || undefined}
          >
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="split split--top">
        <div class="prose" data-reveal>
          <h2 style="margin-top:0">概述</h2>
          <p>{s.summary}</p>
          <p class="muted" style="margin-top:1rem;font-size:var(--fs-xs)">
            {manual ? (
              <>
                完整能力、关键字与算例见 <a href="#docs">用户手册 v{manual.version}</a>（{manual.pages}
                页）。
              </>
            ) : (
              <>以试用版本为准，界面与输出仍在调整。</>
            )}
          </p>
        </div>

        <div data-reveal style="--d:.08s">
          <h2 style="margin-top:0">能做什么</h2>
          <dl class="cap-list">
            {s.features.map((f) => (
              <div class="cap-list__row">
                <dt>{f.title}</dt>
                <dd>{f.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  {
    s.cases.length > 0 && (
      <section class="media-band" id="cases">
        <div class="container">
          <div class="section-head">
            <div class="section-head__text">
              <span class="eyebrow eyebrow--media">Showcase</span>
              <h2 style="margin-top:.65rem">案例</h2>
            </div>
          </div>
          <CaseGallery cases={s.cases} badge={s.name} />
        </div>
      </section>
    )
  }

  <section class="section--tight section--line" id="specs">
    <div class="container">
      <div class="split split--top">
        <div data-reveal>
          <span class="eyebrow">Specifications</span>
          <h2 style="margin-top:.6rem">技术规格</h2>
          <p class="muted" style="margin-top:.6rem;font-size:var(--fs-sm);line-height:1.7">
            {manual ? (
              <>
                表格只列主干项，完整参数、关键字说明与算例见 <a href="#docs">用户手册</a>。
              </>
            ) : (
              <>以试用版本为准，具体参数在试用开始时同步。</>
            )}
          </p>
        </div>
        <div class="table-wrap" data-reveal style="--d:.08s">
          <table class="data">
            <thead>
              <tr>
                <th scope="col">项目</th>
                <th scope="col">说明</th>
              </tr>
            </thead>
            <tbody>
              {specs.map((row) => (
                <tr>
                  <th scope="row" style="background:transparent">
                    {row.k}
                  </th>
                  <td>{row.v}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  {manual && <ManualDocs manual={manual} compact />}

  {
    entry.id === 'cuttinglab' && (
      <section class="section" id="workflow">
        <div class="container">
          <div class="section-head">
            <div class="section-head__text">
              <span class="eyebrow">Workflow</span>
              <h2 style="margin-top:.6rem">五步走完一个算例</h2>
              <p>以二维正交切削为例：从参数到曲线，一条不需要写代码的路径。</p>
            </div>
          </div>

          <ol class="timeline">
            {workflow.map((w) => (
              <li class="timeline__item" data-reveal>
                <span class="timeline__when">{w.when}</span>
                <p class="timeline__what">{w.what}</p>
                <p class="timeline__desc">{w.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    entry.id === 'cuttinglab' && s.roadmap.length > 0 && (
      <section class="section--tight section--line" id="roadmap">
        <div class="container">
          <div class="section-head">
            <div class="section-head__text">
              <span class="eyebrow">Roadmap</span>
              <h2 style="margin-top:.6rem">进度与路线图</h2>
              <p>二维正交切削已全流程打通；三维工况与后续功能按下面的节奏推进。</p>
            </div>
          </div>

          <ol class="timeline">
            {s.roadmap.map((r) => (
              <li class="timeline__item" data-reveal>
                <span class="timeline__when">{r.when}</span>
                <p class="timeline__what">
                  {r.what}
                  <span class:list={['timeline__state', `timeline__state--${r.state}`]}>
                    {r.state === 'done' ? '已打通' : r.state === 'wip' ? '开发中' : '计划'}
                  </span>
                </p>
                {r.desc && <p class="timeline__desc">{r.desc}</p>}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    entry.id === 'cuspic' ? (
      <section class="section--tight">
        <div class="container">
          <div class="contact-strip">
            <span class="contact-strip__label">联系</span>
            <a href={`mailto:${email}`}>{email}</a>
            {manual && (
              <>
                <span class="contact-strip__sep" aria-hidden="true">
                  ·
                </span>
                <a href={manual.file} download>
                  用户手册（PDF，{manual.size}）
                </a>
              </>
            )}
            <span class="contact-strip__sep" aria-hidden="true">
              ·
            </span>
            <a href="/software">软件总览</a>
          </div>
        </div>
      </section>
    ) : (
      s.application && <TrialApply app={s.application} product={s.name} />
    )
  }
</Base>
